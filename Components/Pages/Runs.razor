@page "/runs"
@inject Supabase.Client Db
@using MindRush.Models
@using static Supabase.Postgrest.Constants

<PageTitle>MindRush | Manage runs</PageTitle>

<div class="mx-auto max-w-3xl px-4 py-8 text-[#383838]">
    <a href="/" class="font-bold underline">← Home</a>
    <h1 class="mt-4 text-3xl font-bold">Manage runs</h1>

    @* ---------- STEP 7: CREATE ---------- *@
    <div class="mt-6 flex flex-wrap gap-2">
        <input @bind="newName" @bind:event="oninput"
               maxlength="@GameSettings.MaxDisplayNameLength"
               placeholder="Player name"
               class="rounded border px-3 py-2" />
        <input @bind="newScore" type="number" min="0"
               class="w-28 rounded border px-3 py-2" />
        <button @onclick="Add" disabled="@saving"
                class="rounded bg-red-800 px-4 py-2 text-white disabled:opacity-50">
            Add
        </button>
    </div>

    @if (error is not null)
    {
        <p class="mt-3 rounded border border-red-300 bg-red-50 p-2 text-red-700">@error</p>
    }

    @* ---------- STEP 6: READ ---------- *@
    @if (loading)
    {
        <p class="mt-6">Loading...</p>
    }
    else if (items.Count == 0)
    {
        <p class="mt-6">No runs yet. Add one above.</p>
    }
    else
    {
        <ul class="mt-6 space-y-2">
            @foreach (var s in items)
            {
                @* ---------- STEP 8: UPDATE + DELETE buttons ---------- *@
                <li class="flex items-center gap-3 rounded border p-3">
                    <span class="flex-1">@s.PlayerName · @s.Score pts</span>
                    <button @onclick="() => Raise(s)" class="rounded border px-3 py-1">+10</button>
                    <button @onclick="() => Remove(s)" class="rounded border px-3 py-1 text-red-700">Delete</button>
                </li>
            }
        </ul>
    }
</div>

@code {
    List<GameSession> items = new();
    bool loading = true;
    bool saving;
    string? error;

    string newName = "";
    int newScore;

    protected override async Task OnInitializedAsync() => await Load();

    // STEP 6: read. Where comes before Get, so the database does the filtering.
    async Task Load()
    {
        try
        {
            var res = await Db.From<GameSession>()
                .Where(s => s.DeletedAt == null)            // habit 2: skip soft-deleted rows
                .Order(s => s.Id, Ordering.Descending)
                .Range(0, 49)                               // first 50
                .Get();                                     // sends GET
            items = res.Models;
        }
        catch (Exception ex)
        {
            error = "Could not load: " + ex.Message;
        }
        loading = false;
    }

    // STEP 7: create (sends POST)
    async Task Add()
    {
        if (string.IsNullOrWhiteSpace(newName)) return;
        saving = true;
        error = null;
        try
        {
            await Db.From<GameSession>().Insert(new GameSession
            {
                PlayerName = newName.Trim(),
                Score = newScore,
                CorrectCount = newScore / GameSettings.PointsPerCorrect,
                AnsweredCount = newScore / GameSettings.PointsPerCorrect,
                DurationSeconds = GameSettings.RoundSeconds
            });
            newName = "";
            newScore = 0;
        }
        catch (Exception ex)
        {
            error = "Could not add: " + ex.Message;
        }
        saving = false;
        await Load();
    }

    // STEP 8: update (sends PATCH)
    async Task Raise(GameSession s)
    {
        await Db.From<GameSession>()
            .Where(x => x.Id == s.Id)                       // always use Where
            .Set(x => x.Score, s.Score + 10)
            .Update();
        await Load();
    }

    // STEP 8: soft delete (just an update that fills deleted_at)
    async Task Remove(GameSession s)
    {
        await Db.From<GameSession>()
            .Where(x => x.Id == s.Id)                       // always use Where
            .Set(x => x.DeletedAt, DateTime.UtcNow)
            .Update();
        await Load();
    }
}